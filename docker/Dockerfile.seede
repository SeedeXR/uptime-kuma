# Self-contained image for Seede XR Monitor — builds a REBRANDED image without
# depending on the louislam/uptime-kuma:* base images (which the stock
# docker/dockerfile uses and Coolify cannot rebuild).
#
# Lean SQLite deployment. Optional features NOT included (document if needed):
#   - Chromium ("real browser" monitor type + screenshots)
#   - Apprise notifications, cloudflared tunnel, embedded MariaDB
# Use an external MariaDB or the default SQLite (persist /app/data).

# ---- Build stage (full image: has python3/make/g++ for native modules) ----
FROM node:22-bookworm AS builder
WORKDIR /app

# Don't pull browser binaries we don't ship
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1

# Install ALL deps (devDeps needed to build the frontend) — leave NODE_ENV unset here
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build \
    && npm prune --omit=dev

# ---- Runtime stage (slim: only what the app needs at run time) ----
FROM node:22-bookworm-slim AS release
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        dumb-init \
        iputils-ping \
        sqlite3 \
        ca-certificates \
        curl \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    UPTIME_KUMA_IS_CONTAINER=1

# Native .node binaries built in the builder are glibc-compatible (same Debian base)
COPY --from=builder /app /app
RUN mkdir -p ./data

EXPOSE 3001

# HTTP "/" returns 302 when healthy (see extra/healthcheck.js). Grace period covers
# first-run DB migrations. Coolify: allow 302 and set a >=180s health grace period.
HEALTHCHECK --interval=60s --timeout=30s --start-period=180s --retries=5 \
    CMD node extra/healthcheck.js

VOLUME ["/app/data"]
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server/server.js"]
