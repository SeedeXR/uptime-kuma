# Seede XR Monitor — environment variables
# Copy to .env (which is gitignored) and fill in real values.

# --- Resend email (branded notification emails) ---
# Get an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender, used exactly as written. Put a custom name in front to show it in inboxes:
#   EMAIL_FROM="Seede XR <noreply@mail.seedexr.com>"   (or just noreply@mail.seedexr.com)
# The address must be on a domain verified in Resend.
EMAIL_FROM="Seede XR <noreply@mail.seedexr.com>"

# --- Admin bootstrap ---
# Created on startup if no user with this username exists; never overwritten afterwards
# (change the password in Settings → Security). More admins: Settings → Users.
SEEDE_ADMIN_USERNAME=a.mkwizu@seedexr.com
SEEDE_ADMIN_PASSWORD=

# Public address of the dashboard. Seeds Settings → General → Primary Base URL on first boot
# (password-reset links and the MCP URL use it); a value set in the UI wins.
SEEDE_PRIMARY_BASE_URL=https://status.seedexr.com

# --- App (optional) ---
# PORT=3001
# DATA_DIR=./data/
