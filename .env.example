# Seede XR Monitor — environment variables
# Copy to .env (which is gitignored) and fill in real values.

# --- Resend email (branded notification emails) ---
# Get an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The verified "from" address, e.g. alerts@yourdomain.com
EMAIL_FROM=alerts@seedexr.com
# Optional display name (defaults to "Seede XR")
RESEND_FROM_NAME="Seede XR"

# --- Admin bootstrap ---
# Created on startup if no user with this username exists; never overwritten afterwards
# (change the password in Settings → Security). More admins: Settings → Users.
SEEDE_ADMIN_USERNAME=a.mkwizu@seedexr.com
SEEDE_ADMIN_PASSWORD=

# --- App (optional) ---
# PORT=3001
# DATA_DIR=./data/
